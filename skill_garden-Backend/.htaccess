<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass Authorization Header to PHP (Crucial for JWT Bearer Tokens)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Automatically forward requests from /api/endpoint.php to /api/api/endpoint.php if file exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/api/
  RewriteRule ^(.*)$ api/$1 [L]
</IfModule>
