# ===================================================================
# SKILLGARDEN BACKEND ENVIRONMENT CONFIGURATION (.env)
# ===================================================================
# Hướng dẫn:
# 1. Điền/Sửa thông số IP, tên DB, user, password bên dưới.
# 2. File này được bảo mật và KHÔNG được push lên Git public.
# ===================================================================

# -------------------------------------------------------------------
# 1. CẤU HÌNH ỨNG DỤNG (APPLICATION CONFIG)
# -------------------------------------------------------------------
# APP_ENV: Môi trường chạy ứng dụng ('development', 'staging', hoặc 'production')
APP_ENV=development

# APP_URL: Đường dẫn domain gốc của Backend PHP API (Ví dụ: http://localhost:8000 hoặc https://api.skillgarden.com)
APP_URL=http://localhost:8000

# -------------------------------------------------------------------
# 2. CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL (DATABASE CONFIG)
# -------------------------------------------------------------------
# DB_HOST: Địa chỉ IP hoặc tên miền của Server MySQL Database (Ví dụ: 103.142.x.x, db.skillgarden.com, hoặc 127.0.0.1)
DB_HOST=127.0.0.1

# DB_PORT: Cổng kết nối MySQL (Mặc định là 3306)
DB_PORT=3306

# DB_DATABASE: Tên cơ sở dữ liệu đã tạo cho dự án
DB_DATABASE=db_skill_garden

# DB_USERNAME: Tên tài khoản đăng nhập MySQL có quyền truy vấn DB trên
DB_USERNAME=root

# DB_PASSWORD: Mật khẩu đăng nhập MySQL (để trống nếu dùng XAMPP mặc định không pass)
DB_PASSWORD=

# -------------------------------------------------------------------
# 3. CẤU HÌNH BẢO MẬT BẢNG MÃ JWT (JWT AUTHENTICATION CONFIG)
# -------------------------------------------------------------------
# JWT_SECRET: Chuỗi bí mật dùng để ký và xác thực token JWT. 
# CHÚ Ý: Cần thay đổi thành 1 chuỗi ngẫu nhiên dài & phức tạp khi đưa lên Production!
JWT_SECRET=skill_garden_super_secret_jwt_key_2026_!@#123_change_me

# JWT_EXPIRES_IN: Thời gian hết hạn của token đăng nhập (tính bằng giây, 86400s = 24 giờ)
JWT_EXPIRES_IN=86400

# -------------------------------------------------------------------
# 4. CẤU HÌNH TÊN COOKIE & BẢO MẬT (HTTPONLY COOKIE CONFIG)
# -------------------------------------------------------------------
# JWT_COOKIE_NAME: Tên Cookie lưu trên trình duyệt người dùng
JWT_COOKIE_NAME=skill_garden_token

# JWT_COOKIE_SECURE: Bắt buộc HTTPS (Đặt 'true' khi chạy production HTTPS, 'false' khi chạy localhost HTTP)
JWT_COOKIE_SECURE=false

# JWT_COOKIE_SAMESITE: Chính sách SameSite chống CSRF ('Lax' hoặc 'Strict')
JWT_COOKIE_SAMESITE=Lax

# -------------------------------------------------------------------
# 5. CẤU HÌNH TÊN MIỀN ĐƯỢC PHÉP TRUY VẤN (CORS ORIGINS)
# -------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS: Danh sách URL Frontend được phép gọi API (phân cách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# -------------------------------------------------------------------
# 6. CẤU HÌNH CHỐNG BRUTE-FORCE (SECURITY LOCKOUT POLICY)
# -------------------------------------------------------------------
# MAX_LOGIN_ATTEMPTS: Số lần đăng nhập sai tối đa trước khi tạm khóa tài khoản
MAX_LOGIN_ATTEMPTS=5

# LOCKOUT_DURATION_SECONDS: Thời gian tạm khóa tài khoản (tính bằng giây, 900s = 15 phút)
LOCKOUT_DURATION_SECONDS=900
