<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct API requests without SPA redirect
  RewriteRule ^api/ - [L]

  # Redirect all other page requests to index.html for React SPA Router
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
